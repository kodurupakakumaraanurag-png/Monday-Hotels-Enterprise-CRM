# Monday Hotels Enterprise CRM - Production Environment Configuration

# 1. Application Deployment Config
NEXT_PUBLIC_APP_NAME="Monday Hotels Enterprise CRM"
NEXT_PUBLIC_APP_URL="https://mondayhotels-crm.vercel.app" # Or your Vercel deployment URL

# 2. Supabase Database & Auth Configuration
NEXT_PUBLIC_SUPABASE_URL="https://your-supabase-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-public-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-private-service-role-key" # Keep private, NEVER expose to client

# 3. Environment Environment Mode
NODE_ENV="production"
